{
  "name": "@helix/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that gives research agents literature, sequence, protein, structure, genomics, workflow and SLURM tools",
  "bin": {
    "helix-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@helix/process-host": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
